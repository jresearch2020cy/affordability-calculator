---
import Layout from '../../layouts/Layout.astro';
import employmentData from '../../data/employment.json';

export async function getStaticPaths() {
  const uniqueSlugs = new Set();
  
  return employmentData.filter(job => {
    const slug = String(job.Spine_Point_or_Role).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    if (uniqueSlugs.has(slug)) {
      return false; // Skip duplicates
    }
    uniqueSlugs.add(slug);
    return true; // Keep unique
  }).map(job => {
    const slug = String(job.Spine_Point_or_Role).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    return {
      params: { slug },
      props: { job }
    };
  });
}

const { slug } = Astro.params;
const { job } = Astro.props;

// Function to get clean display name
function getJobName(jobRow) {
  const name = String(jobRow.Spine_Point_or_Role);
  const type = String(jobRow.Institution_Type);
  
  if (type === 'Mainstream' || type === 'Sixth-form') {
    const cat = String(jobRow.Pay_Category || '').toLowerCase();
    if (cat.includes('unqualified')) return `Unqualified Teacher (Point ${name})`;
    if (cat.includes('main')) return `Teacher - Main Pay Range (${name})`;
    if (cat.includes('upper')) return `Teacher - Upper Pay Range (${name})`;
    if (cat.includes('lead')) return `Lead Practitioner Teacher (Point ${name})`;
    if (cat.includes('leadership')) return `Leadership Teacher (${name})`;
    return `Teacher - ${jobRow.Pay_Category} (${name})`;
  }
  
  if (type === 'NHS' && !name.toLowerCase().includes('nhs')) return `NHS ${name}`;
  return name;
}

const displayName = getJobName(job);
---

<Layout title={`${displayName} Salary & Mortgage Limits | UK Affordability`} description={`Find out how much a ${displayName} can borrow for a mortgage and where in the UK they can afford to buy a property.`}>
  <a href="/" style="display: inline-block; margin-bottom: 1.5rem; font-weight: bold; color: #2563eb;">← Back to Calculator</a>

  <div class="card" style="border-top: 4px solid #2563eb;">
    <h1 style="font-size: 2.25rem; margin-bottom: 1rem; text-transform: capitalize;">{displayName} Mortgage & Salary Guide</h1>
    <p style="font-size: 1.1rem; color: #334155;">
      A <strong>{displayName}</strong> typically earns a base salary of <strong>£{job.Annual_Gross_Salary.toLocaleString()}</strong> per year. 
    </p>
    <p style="font-size: 1.1rem; color: #334155;">
      Assuming a standard 4.5x mortgage lending multiplier, the maximum borrowing capacity is estimated at <strong>£{Math.round(job.Annual_Gross_Salary * 4.5).toLocaleString()}</strong>.
    </p>
  </div>
  
  <div style="text-align: center; margin-top: 2rem;">
    <h2>Where can a {displayName} afford to buy?</h2>
    <p>Select a region below to see detailed property affordability analysis, deposit requirements, and tax estimates.</p>
    <a href="/" style="display: inline-block; margin-top: 1rem; padding: 1rem 2rem; background: #2563eb; color: white; border-radius: 8px; text-decoration: none; font-weight: bold;">Use the Affordability Calculator</a>
  </div>
</Layout>
