---
import Layout from '../../layouts/Layout.astro';
import propertyData from '../../data/property.json';

export async function getStaticPaths() {
  const uniqueSlugs = new Set();
  
  return propertyData.filter(loc => {
    const slug = loc.Region_Name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    if (uniqueSlugs.has(slug)) {
      return false; // Skip duplicates
    }
    uniqueSlugs.add(slug);
    return true; // Keep unique
  }).map(loc => {
    const slug = loc.Region_Name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    return {
      params: { slug },
      props: { location: loc }
    };
  });
}

const { slug } = Astro.params;
const { location } = Astro.props;
---

<Layout title={`Property Affordability in ${location.Region_Name} | UK Guide`} description={`Discover average house prices, deposit requirements, and mortgage affordability for ${location.Region_Name}.`}>
  <a href="/" style="display: inline-block; margin-bottom: 1.5rem; font-weight: bold; color: #2563eb;">← Back to Calculator</a>

  <div class="card" style="border-top: 4px solid #16a34a;">
    <h1 style="font-size: 2.25rem; margin-bottom: 1rem; text-transform: capitalize;">Property Prices in {location.Region_Name}</h1>
    <p style="font-size: 1.1rem; color: #334155;">
      Current market averages for residential properties in <strong>{location.Region_Name}</strong>.
    </p>
  </div>
  
  <div class="grid">
    <div class="card">
      <h3 style="margin-top: 0;">Terraced House</h3>
      <p style="font-size: 1.5rem; font-weight: bold; color: #0f172a; margin: 0.5rem 0;">£{location.Terraced_Average_Price.toLocaleString()}</p>
    </div>
    <div class="card">
      <h3 style="margin-top: 0;">Semi-Detached House</h3>
      <p style="font-size: 1.5rem; font-weight: bold; color: #0f172a; margin: 0.5rem 0;">£{location.Semi_Detached_Average_Price.toLocaleString()}</p>
    </div>
    <div class="card">
      <h3 style="margin-top: 0;">Detached House</h3>
      <p style="font-size: 1.5rem; font-weight: bold; color: #0f172a; margin: 0.5rem 0;">£{location.Detached_Average_Price.toLocaleString()}</p>
    </div>
    <div class="card">
      <h3 style="margin-top: 0;">Flat / Apartment</h3>
      <p style="font-size: 1.5rem; font-weight: bold; color: #0f172a; margin: 0.5rem 0;">£{location.Flat_Average_Price.toLocaleString()}</p>
    </div>
  </div>

  <div style="text-align: center; margin-top: 2rem;">
    <h2>Can you afford to live in {location.Region_Name}?</h2>
    <p>Select your profession in our calculator to see exact deposit needs and mortgage limits.</p>
    <a href="/" style="display: inline-block; margin-top: 1rem; padding: 1rem 2rem; background: #16a34a; color: white; border-radius: 8px; text-decoration: none; font-weight: bold;">Check Affordability Now</a>
  </div>
</Layout>
