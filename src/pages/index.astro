---
import Layout from '../layouts/Layout.astro';
import employmentData from '../data/employment.json';
import propertyData from '../data/property.json';
---

<Layout 
  title="UK Housing Affordability & Mortgage Calculator" 
  description="Calculate realistic mortgage affordability, deposit gaps, and housing costs across UK local authorities based on your specific salary and public sector pay scale."
>
  <div style="text-align: center; margin-bottom: 3.5rem; margin-top: 1rem;">
    <h1 style="font-size: 2.75rem; margin-bottom: 1.5rem; letter-spacing: -1px;">Can You Afford to Buy a House?</h1>
    <p style="font-size: 1.25rem; color: #475569; max-width: 800px; margin: 0 auto; line-height: 1.8;">
      We cross-reference <strong>{employmentData.length.toLocaleString()}</strong> exact UK salaries with local property prices across <strong>{propertyData.length}</strong> regions to give you instant, data-driven mortgage limits and deposit requirements.
    </p>
  </div>

  <div class="card" style="margin-bottom: 3rem; background: #eff6ff; border-color: #bfdbfe;">
    <h2 style="color: #1e40af;">How This Engine Works</h2>
    <p style="color: #1e3a8a; font-size: 1.1rem;">Generic mortgage calculators ask you to guess your limits. We use real-world data instead. We match exact public and private sector pay scales against current HM Land Registry data to answer one critical question: <strong>Where can your specific profession actually afford to buy?</strong></p>
    <ul style="margin-bottom: 0; padding-left: 1.5rem; color: #1e3a8a; line-height: 1.8;">
      <li><strong>Step 1:</strong> Select your specific profession or spine point below.</li>
      <li><strong>Step 2:</strong> Choose your local authority.</li>
      <li><strong>Step 3:</strong> See your exact 4.5x borrowing limit and real-world deposit shortfalls.</li>
    </ul>
  </div>

  <!-- SEARCH BAR -->
  <div style="margin-bottom: 2rem;">
    <input 
      type="text" 
      id="searchBox" 
      placeholder="Type to search for a profession (e.g., 'Band 6', 'Major') or location (e.g., 'Manchester')..." 
      style="width: 100%; padding: 1rem; font-size: 1.1rem; border: 2px solid #cbd5e1; border-radius: 8px; box-sizing: border-box;"
    />
  </div>

  <div class="grid">
    <div class="card">
      <h2>Salaries & Professions</h2>
      <p style="color: #64748b; margin-bottom: 1.5rem;">Select your role to view borrowing limits.</p>
      
      <div style="max-height: 500px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; background: #f8fafc;">
        <ul style="list-style: none; padding: 0; margin: 0;">
          {employmentData.map((job) => {
            const slug = String(job.Spine_Point_or_Role).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            return <li class="searchable-item" style="margin-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
              <a href={`/professions/${slug}`} style="display: block; padding: 0.25rem 0;">Mortgage limit for {job.Spine_Point_or_Role}</a>
            </li>
          })}
        </ul>
      </div>
    </div>
    
    <div class="card">
      <h2>Local Authority Markets</h2>
      <p style="color: #64748b; margin-bottom: 1.5rem;">Select a region to view house prices.</p>
      
      <div style="max-height: 500px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; background: #f8fafc;">
        <ul style="list-style: none; padding: 0; margin: 0;">
          {propertyData.map((location) => {
            const slug = location.Region_Name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            return <li class="searchable-item" style="margin-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
              <a href={`/locations/${slug}`} style="display: block; padding: 0.25rem 0;">House prices in {location.Region_Name}</a>
            </li>
          })}
        </ul>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('searchBox').addEventListener('input', function(e) {
      const term = e.target.value.toLowerCase();
      const items = document.querySelectorAll('.searchable-item');
      
      items.forEach(item => {
        const text = item.textContent.toLowerCase();
        if (text.includes(term)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  </script>
</Layout>
