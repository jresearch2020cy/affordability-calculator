import Layout from '../../../../layouts/Layout.astro';
import employmentData from '../../../../data/employment.json';
import propertyData from '../../../../data/property.json';

// THIS MUST BE FALSE
export const prerender = false;

// GRAB PARAMS DIRECTLY (NO getStaticPaths needed!)
const { profession, location } = Astro.params;
const propertyTypeParam = Astro.url.searchParams.get('type') || 'terraced';

const job = employmentData.find(j => String(j.Spine_Point_or_Role).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') === profession);
const loc = propertyData.find(l => l.Region_Name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') === location);

if (!job || !loc) return Astro.redirect('/404');

// ... rest of the math and calculations ...


// Clean job name
function getJobName(jobRow) {
  const name = String(jobRow.Spine_Point_or_Role);
  const type = String(jobRow.Institution_Type);
  if (type === 'Mainstream' || type === 'Sixth-form') {
    const cat = String(jobRow.Pay_Category || '').toLowerCase();
    if (cat.includes('unqualified')) return `Unqualified Teacher (Point ${name})`;
    if (cat.includes('main')) return `Teacher - Main Pay Range (${name})`;
    if (cat.includes('upper')) return `Teacher - Upper Pay Range (${name})`;
    if (cat.includes('lead')) return `Lead Practitioner Teacher (Point ${name})`;
    if (cat.includes('leadership')) return `Leadership Teacher (${name})`;
    return `Teacher - ${jobRow.Pay_Category} (${name})`;
  }
  if (type === 'NHS' && !name.toLowerCase().includes('nhs')) return `NHS ${name}`;
  return name;
}
const displayName = getJobName(job);

// Setup Property Type
let targetProperty = loc.Terraced_Average_Price;
let propertyTypeLabel = "terraced house";

if (propertyTypeParam === 'flat') {
  targetProperty = loc.Flat_Average_Price;
  propertyTypeLabel = "flat";
} else if (propertyTypeParam === 'semi') {
  targetProperty = loc.Semi_Detached_Average_Price;
  propertyTypeLabel = "semi-detached house";
} else if (propertyTypeParam === 'detached') {
  targetProperty = loc.Detached_Average_Price;
  propertyTypeLabel = "detached house";
}

// Financial Math
const maxBorrowing = Math.round(job.Annual_Gross_Salary * 4.5);
const rawShortfall = targetProperty - maxBorrowing;
const minimumTenPercent = targetProperty * 0.1;
const depositRequired = Math.round(Math.max(rawShortfall, minimumTenPercent)); 
const mortgageAmount = Math.round(targetProperty - depositRequired);
const monthlyGross = Math.round(job.Annual_Gross_Salary / 12);

// Stamp Duty
function calculateTax(price, isFTB, btl = false) {
  let surcharge = btl ? 0.05 : 0; 
  if (job.Country === 'Scotland') {
    if (isFTB && price <= 175000) return 0;
    let t = 0;
    if (price > 145000) t += (Math.min(price, 250000) - 145000) * 0.02;
    if (price > 250000) t += (Math.min(price, 325000) - 250000) * 0.05;
    if (price > 325000) t += (Math.min(price, 750000) - 325000) * 0.10;
    if (price > 750000) t += (price - 750000) * 0.12;
    return t + (btl ? price * 0.06 : 0); 
  } else if (job.Country === 'Wales') {
    let t = 0;
    if (price > 225000) t += (Math.min(price, 400000) - 225000) * 0.06;
    if (price > 400000) t += (Math.min(price, 750000) - 400000) * 0.075;
    if (price > 750000) t += (Math.min(price, 1500000) - 750000) * 0.10;
    if (price > 1500000) t += (price - 1500000) * 0.12;
    return t + (btl ? price * 0.04 : 0);
  } else { 
    if (isFTB && price <= 425000 && !btl) return 0;
    if (isFTB && price <= 625000 && !btl) return (price - 425000) * 0.05;
    let t = 0;
    if (price > 250000) t += (Math.min(price, 925000) - 250000) * 0.05;
    if (price > 925000) t += (Math.min(price, 1500000) - 925000) * 0.10;
    if (price > 1500000) t += (price - 1500000) * 0.12;
    return t + (btl ? price * 0.03 : 0);
  }
}

const taxFTB = Math.round(calculateTax(targetProperty, true));
const taxStandard = Math.round(calculateTax(targetProperty, false));
const taxBTL = Math.round(calculateTax(targetProperty, false, true));

// PMT Repayment Formula
function calculatePMT(rate, years, principal) {
  const r = (rate / 100) / 12;
  const n = years * 12;
  return (principal * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
}

const rates = [4, 5, 6, 7];
const terms = [25, 30, 35, 40];

// Alternatives Generator
const rawAlternatives = [
  { type: "Flat", slug: "flat", price: loc.Flat_Average_Price },
  { type: "Terraced", slug: "terraced", price: loc.Terraced_Average_Price },
  { type: "Semi-Detached", slug: "semi", price: loc.Semi_Detached_Average_Price },
  { type: "Detached", slug: "detached", price: loc.Detached_Average_Price }
];

const alternativeProperties = [];
for (const prop of rawAlternatives) {
  if (prop.price > 0 && prop.slug !== propertyTypeParam) {
    const dep = Math.round(Math.max(prop.price - maxBorrowing, prop.price * 0.1));
    const twentyFivePercent = prop.price * 0.25;
    const isAffordable = dep <= twentyFivePercent;
    alternativeProperties.push({ ...prop, deposit: dep, isAffordable });
  }
}
---

<Layout 
  title={`Can a ${displayName} afford a ${propertyTypeLabel} in ${loc.Region_Name}? | UK Affordability`} 
  description={`Analysis of mortgage limits, deposit requirements, and stamp duty for a ${displayName} earning £${job.Annual_Gross_Salary.toLocaleString()} buying a ${propertyTypeLabel} in ${loc.Region_Name}.`}
>
  <a href="/" style="display: inline-block; margin-bottom: 1.5rem; font-weight: bold; color: #2563eb;">← Back to Calculator</a>

  <div class="card" style="border-top: 4px solid #2563eb;">
    <h1 style="font-size: 2.25rem; margin-bottom: 1rem; text-transform: capitalize;">Can a {displayName} buy a {propertyTypeLabel} in {loc.Region_Name}?</h1>
    <p style="font-size: 1.1rem; color: #334155;">
      Based on public data, a <strong>{displayName}</strong> in the {job.Institution_Type} sector earns a gross base salary of <strong>£{job.Annual_Gross_Salary.toLocaleString()}</strong> per year. Assuming a standard 4.5x income multiplier, your maximum mortgage borrowing capacity is estimated at <strong>£{maxBorrowing.toLocaleString()}</strong>.
    </p>
    <p style="font-size: 1.1rem; color: #334155;">
      In <strong>{loc.Region_Name}</strong>, the average {propertyTypeLabel} currently costs <strong>£{targetProperty.toLocaleString()}</strong>. To purchase this property, you would need an estimated cash deposit of <strong>£{depositRequired.toLocaleString()}</strong>.
    </p>
  </div>

  <div class="grid">
    <div class="card">
      <h3 style="text-transform: capitalize;">{propertyTypeLabel} Affordability</h3>
      <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">Avg Property Price</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">£{targetProperty.toLocaleString()}</td></tr>
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">Max Mortgage (4.5x)</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">£{maxBorrowing.toLocaleString()}</td></tr>
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">Est. Deposit Required</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0; font-weight: bold; color: #dc2626; font-size: 1.25rem;">£{depositRequired.toLocaleString()}</td></tr>
      </table>
    </div>

    <div class="card">
      <h3>Estimated Property Tax</h3>
      <p style="font-size: 0.9rem; color: #64748b; margin-top: 0;">Estimated taxes (SDLT/LBTT/LTT) based on property location.</p>
      <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">First-Time Buyer</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">£{taxFTB.toLocaleString()}</td></tr>
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">Standard Home Mover</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">£{taxStandard.toLocaleString()}</td></tr>
        <tr><th style="text-align: left; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">Buy-to-Let / Additional</th><td style="text-align: right; padding: 0.75rem; border-bottom: 1px solid #e2e8f0;">£{taxBTL.toLocaleString()}</td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Monthly Mortgage Repayments</h2>
    <p>Estimated monthly payments for a <strong>£{mortgageAmount.toLocaleString()}</strong> mortgage. Percentages show how much of your <strong>gross monthly income (£{monthlyGross.toLocaleString()})</strong> goes toward the mortgage.</p>
    
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; margin-top: 1rem; text-align: center;">
        <thead>
          <tr style="background: #f1f5f9;">
            <th style="padding: 1rem; border: 1px solid #cbd5e1;">Rate</th>
            {terms.map(t => <th style="padding: 1rem; border: 1px solid #cbd5e1;">{t} Years</th>)}
          </tr>
        </thead>
        <tbody>
          {rates.map(rate => (
            <tr>
              <td style="padding: 1rem; border: 1px solid #cbd5e1; font-weight: bold;">{rate}%</td>
              {terms.map(term => {
                const pmt = calculatePMT(rate, term, mortgageAmount);
                const burden = ((pmt / monthlyGross) * 100).toFixed(1);
                return (
                  <td style="padding: 1rem; border: 1px solid #cbd5e1;">
                    <div style="font-size: 1.1rem; font-weight: 500;">£{Math.round(pmt).toLocaleString()} <span style="font-size: 0.85rem; color: #64748b; font-weight: normal;">/ mo</span></div>
                    <div style={`font-size: 0.85rem; margin-top: 0.25rem; color: ${Number(burden) > 40 ? '#dc2626' : '#16a34a'}`}>({burden}% of gross salary)</div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card" style="background: #f8fafc; text-align: center;">
    <h2 style="margin-bottom: 1.5rem;">What else can you afford in {loc.Region_Name}?</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      {alternativeProperties.map(prop => {
        return (
          <a href={`?type=${prop.slug}`} style={`display: block; text-decoration: none; border: 2px solid ${prop.isAffordable ? '#22c55e' : '#ef4444'}; background: white; padding: 1.5rem; border-radius: 8px; min-width: 200px; transition: transform 0.2s; cursor: pointer; color: inherit;`}>
            <h4 style="margin: 0 0 0.5rem 0; color: #0f172a;">{prop.type}</h4>
            <p style="margin: 0; font-size: 0.9rem; color: #64748b;">Avg Price: £{prop.price.toLocaleString()}</p>
            <p style={`margin: 0.5rem 0 0 0; font-weight: bold; color: ${prop.isAffordable ? '#16a34a' : '#dc2626'};`}>
              Deposit: £{prop.deposit.toLocaleString()}
            </p>
          </a>
        )
      })}
    </div>
  </div>
</Layout>
